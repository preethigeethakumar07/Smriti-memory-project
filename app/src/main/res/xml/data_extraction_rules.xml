<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Smriti stores may leave the phone through Android's backup or a phone-to-phone transfer: no memories, no pictures, no keys, no saved places.
  (allowBackup is already off; this says so for Android 12 and later in the form those versions read.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
